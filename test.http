### ================================================================
### AUTH MODULE
### ================================================================

### Register a normal user
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "email": "new-user@example.com",
    "password": "User@123",
    "name": "New User"
}

### Login as normal user
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "user@example.com",
    "password": "123456"
}

### Login as admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@example.com",
    "password": "Admin@123"
}

### Refresh access token (REST Client may reuse the login cookie)
POST {{baseUrl}}/auth/refresh
Cookie: refreshToken={{refreshToken}}

### Send email verification
POST {{baseUrl}}/auth/email/send-verification
Content-Type: application/json

{
    "email": "new-user@example.com"
}

### Verify email
GET {{baseUrl}}/auth/email/verify?token={{verificationToken}}

### Forgot password
POST {{baseUrl}}/auth/password/forgot
Content-Type: application/json

{
    "email": "user@example.com"
}

### Open reset-password form
GET {{baseUrl}}/auth/password/reset?token={{resetToken}}

### Reset password through the API
POST {{baseUrl}}/auth/password/reset
Content-Type: application/json

{
    "token": "{{resetToken}}",
    "newPassword": "NewUser@123"
}

### Change password
PUT {{baseUrl}}/auth/password/change
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "currentPassword": "123456",
    "newPassword": "User@123"
}

### Start 2FA setup
POST {{baseUrl}}/auth/2fa/setup
Authorization: Bearer {{accessToken}}

### Enable 2FA
POST {{baseUrl}}/auth/2fa/enable
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "code": "{{twoFactorCode}}"
}

### Login with 2FA
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "user@example.com",
    "password": "User@123",
    "twoFactorCode": "{{twoFactorCode}}"
}

### Disable 2FA
POST {{baseUrl}}/auth/2fa/disable
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "password": "User@123",
    "code": "{{twoFactorCode}}"
}

### Logout current session
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}
Cookie: refreshToken={{refreshToken}}

### Logout all sessions
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer {{accessToken}}
Cookie: refreshToken={{refreshToken}}

### Google OAuth entry point (open in a browser)
GET {{baseUrl}}/auth/google

### ================================================================
### USER MODULE
### ================================================================

### Get current user
GET {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}

### Update current user profile
PUT {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "name": "Updated User",
    "avatarUrl": "https://example.com/avatar.png"
}

### Change current user email
PUT {{baseUrl}}/users/me/email
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "newEmail": "updated-user@example.com",
    "password": "User@123"
}

### List current user sessions
GET {{baseUrl}}/users/me/sessions?page=1&pageSize=20
Authorization: Bearer {{accessToken}}

### Delete one current user session
DELETE {{baseUrl}}/users/me/sessions/{{sessionId}}
Authorization: Bearer {{accessToken}}

### Delete all current user sessions
DELETE {{baseUrl}}/users/sessions
Authorization: Bearer {{accessToken}}

### Delete current user account
DELETE {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "password": "User@123"
}

### List users (admin + user:read permission)
GET {{baseUrl}}/users/?page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}

### Get one user (admin + user:read permission)
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{adminAccessToken}}

### Update one user (admin + user:update permission)
PUT {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
    "name": "Admin Updated User",
    "isEmailVerified": true
}

### Delete one user (admin + user:delete permission)
DELETE {{baseUrl}}/users/d25fd54a-931f-45b3-8e5f-ffa2641b1370
Authorization: Bearer {{adminAccessToken}}

### ================================================================
### ROLE MODULE
### ================================================================

### List roles (admin)
GET {{baseUrl}}/roles/
Authorization: Bearer {{adminAccessToken}}

### ================================================================
### PERMISSION MODULE
### ================================================================

### List permissions and attached roles (admin + permission:manage)
GET {{baseUrl}}/permissions/
Authorization: Bearer {{adminAccessToken}}

### Create permission
POST {{baseUrl}}/permissions/
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
    "name": "report:read",
    "description": "View reports"
}

### Attach permission to role
POST {{baseUrl}}/permissions/roles/{{roleId}}/{{permissionId}}
Authorization: Bearer {{adminAccessToken}}

### Detach permission from role
DELETE {{baseUrl}}/permissions/roles/{{roleId}}/{{permissionId}}
Authorization: Bearer {{adminAccessToken}}